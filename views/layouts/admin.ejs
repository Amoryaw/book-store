<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title || 'Admin' %> | Admin Book Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>
</head>
<body class="bg-light">
  <div class="container-fluid">
    <div class="row">
      <nav class="col-md-2 bg-dark min-vh-100 p-3">
        <a class="navbar-brand text-white fs-5 d-block mb-4" href="/admin">Admin</a>
        <div class="nav flex-column">
          <a class="nav-link text-white <%= locals.active === 'dashboard' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin">Tổng quan</a>
          <a class="nav-link text-white <%= locals.active === 'books' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin/books">Sách</a>
          <a class="nav-link text-white <%= locals.active === 'orders' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin/orders">Đơn hàng</a>
          <a class="nav-link text-white <%= locals.active === 'coupons' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin/coupons">Mã giảm giá</a>
          <a class="nav-link text-white <%= locals.active === 'users' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin/users">Người dùng</a>
          <a class="nav-link text-white <%= locals.active === 'banners' ? 'fw-bold bg-secondary rounded' : '' %>" href="/admin/banners">Banner</a>
          <hr class="text-secondary">
          <a class="nav-link text-white-50" href="/">&larr; Về cửa hàng</a>
        </div>
      </nav>
      <main class="col-md-10 p-4">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>