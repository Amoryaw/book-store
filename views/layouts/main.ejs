<%
  const user = locals.currentUser;
  const menu = locals.menu || { vi: [], en: [] };
  const searchValue = locals.q || '';
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title || 'Book Store' %> | Book Store</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js" defer></script>
  <script src="/js/main.js" defer></script>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">
      <a class="navbar-brand" href="/">Book Store</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sách Tiếng Việt</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/sach-tieng-viet">Tất cả sách Tiếng Việt</a></li>
              <% if (menu.vi.length) { %><li><hr class="dropdown-divider"></li><% } %>
              <% menu.vi.forEach(function (c) { %>
                <li><a class="dropdown-item" href="/sach-tieng-viet/<%= c.slug %>"><%= c.name %></a></li>
              <% }) %>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">English Books</a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/english-books">All English Books</a></li>
              <% if (menu.en.length) { %><li><hr class="dropdown-divider"></li><% } %>
              <% menu.en.forEach(function (c) { %>
                <li><a class="dropdown-item" href="/english-books/<%= c.slug %>"><%= c.nameEn || c.name %></a></li>
              <% }) %>
            </ul>
          </li>
        </ul>

        <form class="d-flex me-3 my-2 my-lg-0" action="/tim-kiem" method="get">
          <input class="form-control form-control-sm me-2" type="search" name="q"
                 value="<%= searchValue %>" placeholder="Tìm sách, tác giả...">
          <button class="btn btn-sm btn-warning" type="submit">Tìm</button>
        </form>

        <div class="d-flex align-items-center gap-2">
          <a class="btn btn-outline-light btn-sm" href="/cart">Giỏ hàng <span id="cartCount" class="badge bg-danger"><%= locals.cartCount || 0 %></span></a>
          <% if (user) { %>
            <span class="text-light">Xin chào, <%= user.fullName %></span>
            <% if (user.role === 'admin') { %>
              <a class="btn btn-warning btn-sm" href="/admin">Admin</a>
            <% } %>
            <a class="btn btn-outline-light btn-sm" href="/orders">Đơn hàng</a>
            <a class="btn btn-outline-light btn-sm" href="/auth/change-password">Đổi mật khẩu</a>
            <button id="logoutBtn" class="btn btn-outline-light btn-sm">Đăng xuất</button>
          <% } else { %>
            <a class="btn btn-outline-light btn-sm" href="/auth/login">Đăng nhập</a>
            <a class="btn btn-primary btn-sm" href="/auth/register">Đăng ký</a>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <main class="container my-4">
    <%- body %>
  </main>
</body>
</html>