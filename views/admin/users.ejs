<h3 class="mb-3">Quản lý người dùng <small class="text-muted fs-6">(<%= total %> tài khoản)</small></h3>

<form class="row g-2 mb-3" method="get" action="/admin/users">
  <div class="col-md-3">
    <select name="status" class="form-select">
      <option value="">Tất cả trạng thái</option>
      <option value="active" <%= status === 'active' ? 'selected' : '' %>>Đang hoạt động</option>
      <option value="blocked" <%= status === 'blocked' ? 'selected' : '' %>>Đã khóa</option>
    </select>
  </div>
  <div class="col-md-5">
    <input name="q" value="<%= q %>" class="form-control" placeholder="Tên, email hoặc số điện thoại">
  </div>
  <div class="col-md-2"><button class="btn btn-primary w-100">Lọc</button></div>
</form>

<div class="table-responsive bg-white">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light">
      <tr>
        <th>Họ tên</th><th>Email</th><th>SĐT</th><th>Vai trò</th><th class="text-center">Đơn hàng</th>
        <th>Đăng nhập gần nhất</th><th>Trạng thái</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% if (!users.length) { %>
        <tr><td colspan="8" class="text-center text-muted py-4">Không có người dùng nào.</td></tr>
      <% } %>
      <% users.forEach(function (u) { %>
        <tr>
          <td><strong><%= u.fullName %></strong></td>
          <td><%= u.email %></td>
          <td><%= u.phone || '—' %></td>
          <td><span class="badge bg-<%= u.role === 'admin' ? 'dark' : 'light text-dark border' %>"><%= u.role === 'admin' ? 'Admin' : 'Khách hàng' %></span></td>
          <td class="text-center"><%= orderCount[String(u._id)] || 0 %></td>
          <td><small><%= u.lastLoginAt ? u.lastLoginAt.toLocaleString('vi-VN') : 'Chưa đăng nhập' %></small></td>
          <td><span class="badge bg-<%= u.status === 'blocked' ? 'danger' : 'success' %>"><%= u.status === 'blocked' ? 'Đã khóa' : 'Hoạt động' %></span></td>
          <td class="text-end">
            <% if (u.role !== 'admin') { %>
              <% if (u.status === 'blocked') { %>
                <button class="btn btn-sm btn-outline-success" data-user-status data-id="<%= u._id %>" data-status="active" data-name="<%= u.fullName %>">Mở khóa</button>
              <% } else { %>
                <button class="btn btn-sm btn-outline-danger" data-user-status data-id="<%= u._id %>" data-status="blocked" data-name="<%= u.fullName %>">Khóa</button>
              <% } %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
  <nav class="mt-3">
    <ul class="pagination">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="/admin/users?page=<%= i %>&status=<%= status %>&q=<%= encodeURIComponent(q) %>"><%= i %></a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>

<script src="/js/admin-users.js" defer></script>