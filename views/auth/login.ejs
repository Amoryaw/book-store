<div class="row justify-content-center">
  <div class="col-md-5">
    <h2 class="text-center mb-3">Đăng nhập</h2>
    <div id="alertBox"></div>
    <form id="authForm" data-action="/auth/login">
      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" required>
      </div>
      <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" required>
      </div>
      <button type="submit" class="btn btn-primary w-100">Đăng nhập</button>
    </form>
    <p class="text-center mt-3 mb-0"><a href="/auth/forgot-password">Quên mật khẩu?</a></p>
    <p class="text-center mt-3">Chưa có tài khoản? <a href="/auth/register">Đăng ký</a></p>
  </div>
</div>
<script src="/js/auth.js" defer></script>